# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Environment files
.env
.env.*

# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan

# Terraform variable files - may contain sensitive values
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc*:Zone.Identifier
